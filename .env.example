# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional: which Claude model powers the partner
ANTHROPIC_MODEL=claude-sonnet-5-5

# Only this email can use the app
ALLOWED_EMAIL=maxwellrgross@gmail.com

# Your time zone decides when "today" starts
APP_TIMEZONE=America/New_York

# Optional: the app's display name (defaults to truetomax)
# NEXT_PUBLIC_APP_NAME=truetomax

# Google Calendar (read-only). Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: https://YOUR-APP.vercel.app/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Instagram (read-only). Meta app → Instagram → API setup with Instagram login → Instagram app ID / secret
# Valid OAuth redirect URI: https://YOUR-APP.vercel.app/api/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
